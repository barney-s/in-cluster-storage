# Instance: ics3 (KOPS on GCE)
# Pinned settings: Project: barni-cnrm-20260529, Cluster: ics3
# Source this file to initialize the deployment parameters as shell variables.

export GCP_PROJECT="barni-cnrm-20260529"
export GCP_REGION="${CLOUDSDK_COMPUTE_REGION:-us-central1}"
export GCP_ZONE="${CLOUDSDK_COMPUTE_ZONE:-us-central1-a}"

export CLUSTER="ics3"
export KOPS_CLUSTER_NAME="${CLUSTER}.k8s.local"
export KOPS_STATE_STORE="gs://${GCP_PROJECT}-${CLUSTER}-kops-state"

export GAR_LOCATION="${GAR_LOCATION:-us-central1}"
export GAR_REPOSITORY="in-cluster-storage"
export IMAGE_TAG="${IMAGE_TAG:-latest}"

export REGISTRY="${GAR_LOCATION}-docker.pkg.dev/${GCP_PROJECT}/${GAR_REPOSITORY}"
