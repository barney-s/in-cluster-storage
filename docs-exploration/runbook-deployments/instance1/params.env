# Instance: instance1 (GKE Standard Cluster)
# Source this file to initialize the deployment parameters as shell variables.

# Unique Resource Prefix assigned by the environment/harness
export RESOURCE_PREFIX="${RUNBOOK_RESOURCE_PREFIX}"

# Target GCP project ID (pinned per owner/runbook guidance, defaults to GOOGLE_CLOUD_PROJECT or cnrm-barni-2)
export GCP_PROJECT="${GOOGLE_CLOUD_PROJECT:-cnrm-barni-2}"

# Deployment Configuration
export GAR_LOCATION="${CLOUDSDK_COMPUTE_REGION:-us-central1}"
export GKE_ZONE="${CLOUDSDK_COMPUTE_ZONE:-us-central1-a}"

# Every cloud resource is named ${RESOURCE_PREFIX}[-suffix]
export GAR_REPOSITORY="${RESOURCE_PREFIX}"
export GKE_CLUSTER="${RESOURCE_PREFIX}-cluster"
export IMAGE_TAG="${IMAGE_TAG:-latest}"

# Derived full image registry prefix
export REGISTRY="${GAR_LOCATION}-docker.pkg.dev/${GCP_PROJECT}/${GAR_REPOSITORY}"
